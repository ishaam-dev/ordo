# Copy this file to .env and fill in the four values, then: chmod 600 .env
# .env is gitignored — these tokens can act as you in Slack, so they never leave your Mac.
#
# Get both tokens from your app's page at https://api.slack.com/apps/<YOUR_APP_ID>
#   USER_TOKEN  OAuth & Permissions  ->  "User OAuth Token"          (starts xoxp-)
#                 Reads the messages you can see, and posts your replies.
#   APP_TOKEN   Basic Information    ->  App-Level Tokens            (starts xapp-)
#                 Generate one with the connections:write scope. It opens the
#                 socket Slack pushes new messages down; it cannot read anything.
#
# One app per workspace, so one pair of tokens per workspace. A workspace is only
# switched on when BOTH of its tokens are filled in — leave B blank to run just one.

# Workspace A
SLACK_A_USER_TOKEN=xoxp-...
SLACK_A_APP_TOKEN=xapp-...

# Workspace B (optional)
SLACK_B_USER_TOKEN=
SLACK_B_APP_TOKEN=

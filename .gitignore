# Secrets — .env holds real Slack user tokens.
# Broad match so editor swap/backup files (.env.swp, .env~, .env.bak) can never be committed.
.env
.env.*
*.swp
*.swo
*~
!.env.example

node_modules/
dist/

# Mac app build output — regenerated by `npm run app:build`
release/
assets/
electron/assets/
electron/project-path.json

# Runtime state — contains real Slack message content
data.db
data.db-journal
data.db-wal
data.db-shm
data.db.bak-*

.DS_Store

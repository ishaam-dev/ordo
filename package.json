{
  "name": "slack-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local Slack copilot: prioritized feed of DMs/mentions, analyzed by Claude, with Claude Code chat",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "app:icons": "node scripts/make-icons.mjs",
    "app:prepare": "node scripts/prepare-app.mjs",
    "app:dev": "node scripts/prepare-app.mjs && electron electron/main.js",
    "app:build": "node scripts/build-app.mjs"
  },
  "devDependencies": {
    "@slack/cli-hooks": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@slack/bolt": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}
